---
import { GoogleFontsOptimizer } from "astro-google-fonts-optimizer";
import { SEO } from "astro-seo";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../assets/container.css";
import "../assets/custom.css";
---

<html lang="ja" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, user-scalable=no"
    />
    <script is:inline>
      (function () {
        const storageKey = "color-theme";
        let storedTheme = null;

        try {
          storedTheme = localStorage.getItem(storageKey);
        } catch (error) {
          storedTheme = null;
        }

        const prefersDark = window.matchMedia
          ? window.matchMedia("(prefers-color-scheme: dark)").matches
          : false;

        const theme = storedTheme || (prefersDark ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <GoogleFontsOptimizer
      url="https://fonts.googleapis.com/css2?family=M+PLUS+1:wght@100..900&display=swap"
    />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-FV70F5MH3L"
    ></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-FV70F5MH3L");
    </script>

    <link rel="icon" href="/favicon.png" />
    <meta
      name="description"
      content="Shota Minegishi is a doctoral course student of the Faculty of Science and Technology, Sophia University."
    />
    <SEO
      title="Shota Minegishi (@smngs)"
      description="Shota Minegishi is a doctoral course student of the Faculty of Science and Technology, Sophia University, Japan."
    />
    <title>Shota Minegishi (@smngs)</title>
  </head>
  <body>
    <Header />
    <div class="container">
      <slot />
    </div>
    <Footer />
  </body>
</html>
