---
import { SEO } from "astro-seo";
import { GoogleFontsOptimizer } from 'astro-google-fonts-optimizer';
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../assets/container.css"
import "../assets/custom.css"
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <link rel="icon" href="/favicon.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <GoogleFontsOptimizer url="https://fonts.googleapis.com/css2?family=M+PLUS+1:wght@100..900&display=swap" />

    <!-- Google tag (gtag.js) -->
    <script is:inline type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-FV70F5MH3L"></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-FV70F5MH3L');
    </script>

    <SEO
      title="Shota Minegishi (@smngs)"
      description="Shota Minegishi is a doctoral course student of the Faculty of Science and Technology, Sophia University, Japan."
    />
  </head>
  <body>
    <Header />
    <div class="container">
      <slot />
    </div>
    <Footer />
  </body>
</html>
